  {
   "beatId": "beat-N09",
   "sentenceId": "N09",
   "outputStartMs": 58480,
   "outputEndMs": 69730,
   "narrationText": "最有名的驾驶者是夏亚。他的红色扎古单机击沉五艘联邦战舰——四艘巡洋舰、一艘战列舰，赤色彗星从此得名。",
   "claim": {
    "type": "object",
    "minimumVisibleEvidence": [
