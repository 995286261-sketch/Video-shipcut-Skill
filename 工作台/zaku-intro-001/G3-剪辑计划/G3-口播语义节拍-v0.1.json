  {
   "beatId": "beat-N10",
   "sentenceId": "N10",
   "outputStartMs": 69730,
   "outputEndMs": 75220,
   "narrationText": "乔尼·莱登，用的也是量产型火箭筒，在鲁姆击沉三艘麦哲伦级。",
   "claim": {
    "type": "weapon",
