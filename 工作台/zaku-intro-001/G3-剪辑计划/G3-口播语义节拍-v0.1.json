   "allowedVisualAlternatives": []
  },
  {
   "beatId": "beat-N11",
   "sentenceId": "N11",
   "outputStartMs": 75220,
   "outputEndMs": 81030,
   "narrationText": "王牌没有挑选传奇机体——是机体和王牌，互相成就了彼此。",
   "claim": {
