  {
   "beatId": "beat-N03",
   "sentenceId": "N03",
   "outputStartMs": 15060,
   "outputEndMs": 21830,
   "narrationText": "0078 年 1 月，初期量产的 C 型下线，前后只造了 236 架。",
   "claim": {
    "type": "action",
