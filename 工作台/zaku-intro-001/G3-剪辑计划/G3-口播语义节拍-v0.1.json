   "allowedVisualAlternatives": []
  },
  {
   "beatId": "beat-N05",
   "sentenceId": "N05",
   "outputStartMs": 28920,
   "outputEndMs": 36890,
   "narrationText": "17.5 米高的钢铁之躯，120 毫米机枪、280 毫米火箭筒、热能斧，标准三件套。",
   "claim": {
    "type": "weapon",
    "minimumVisibleEvidence": [
     "军刀或火箭筒或枪口任一发射或挥舞"
    ]
