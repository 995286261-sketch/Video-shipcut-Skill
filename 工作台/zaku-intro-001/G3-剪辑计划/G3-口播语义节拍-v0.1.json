  {
   "beatId": "beat-N08",
   "sentenceId": "N08",
   "outputStartMs": 54110,
   "outputEndMs": 58480,
   "narrationText": "一周战争与鲁姆会战，扎古打出的是压倒性战果。",
   "claim": {
    "type": "action",
    "minimumVisibleEvidence": [
     "战舰中弹或扎古火力输出"
