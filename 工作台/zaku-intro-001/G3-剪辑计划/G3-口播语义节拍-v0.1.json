  {
   "beatId": "beat-N07",
   "sentenceId": "N07",
   "outputStartMs": 44860,
   "outputEndMs": 54110,
   "narrationText": "开战之初，联邦军根本没有量产 MS——直到 0079 年 10 月，自己的吉姆才投入实战。",
   "claim": {
    "type": "appearance",
