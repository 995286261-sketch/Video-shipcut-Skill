  {
   "beatId": "beat-N04",
   "sentenceId": "N04",
   "outputStartMs": 21830,
   "outputEndMs": 28920,
   "narrationText": "开战之后，这个数字冲到三千架以上——F 型是公国量产最多的机动战士。",
   "claim": {
    "type": "object",
    "minimumVisibleEvidence": [
