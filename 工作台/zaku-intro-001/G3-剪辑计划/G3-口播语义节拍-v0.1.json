   "allowedVisualAlternatives": []
  },
  {
   "beatId": "beat-N06",
   "sentenceId": "N06",
   "outputStartMs": 36890,
   "outputEndMs": 44860,
   "narrationText": "它没有碾压时代的性能，也没有明显短板——能大量地造、修、开，这就是量产机的生存之道。",
   "claim": {
    "type": "state_change",
    "minimumVisibleEvidence": [
