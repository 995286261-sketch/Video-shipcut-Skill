      "measuredEndMs": 35030,
      "intentDeviationMs": 1862
    },
    {
      "sentenceId": "N05",
      "phraseId": "P2",
      "layoutTier": "推进",
      "text": "U.C. 0094，新吉翁残党「带袖的」一场大胆抢夺，把它从验证机变成了自己的座机。",
