 "timelineMs": 177000,
 "sentences": [
  {
   "sentenceId": "N01",
   "phraseId": "P1",
   "layoutTier": "留白",
   "text": "U.C. 0096，战后不平静的星海——一道红色的影子再度划过，仿佛那颗彗星从未老去。",
   "factRefs": [
    "编辑表达"
   ],
   "targetStartMs": 70,
   "measuredDurMs": 10480,
   "measuredEndMs": 10550
  },
  {
   "sentenceId": "N02",
   "phraseId": "P1",
   "layoutTier": "留白",
   "text": "它叫 MSN-06S 新安洲，属于那个被称为夏亚再世的人。",
   "factRefs": [
    "E1",
    "E3"
   ],
   "targetStartMs": 10983,
   "measuredDurMs": 6880,
   "measuredEndMs": 17863
  },
  {
   "sentenceId": "N03",
   "phraseId": "P2",
   "layoutTier": "推进",
   "text": "可这台机，最初不是为任何人造的——它诞生于地球联邦的 UC 计划。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 18321,
   "measuredDurMs": 7520,
   "measuredEndMs": 25841
  },
  {
   "sentenceId": "N04",
   "phraseId": "P2",
   "layoutTier": "推进",
   "text": "阿纳海姆电子公司拿它验证精神感应骨架技术，实验数据后来直接喂给了 RX-0 独角兽高达。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 26215,
   "measuredDurMs": 8880,
   "measuredEndMs": 35095
  },
  {
   "sentenceId": "N05",
   "phraseId": "P2",
   "layoutTier": "推进",
   "text": "U.C. 0094，新吉翁残党「带袖的」一场大胆抢夺，把它从验证机变成了自己的座机。",
   "factRefs": [
    "E1",
    "E3"
   ],
   "targetStartMs": 35503,
   "measuredDurMs": 8480,
   "measuredEndMs": 43983
  },
  {
   "sentenceId": "N06",
   "phraseId": "P2",
   "layoutTier": "推进",
   "text": "他们要的从来不只是一台高性能 MS，而是一面能收拢人心的旗。",
   "factRefs": [
    "编辑表达"
   ],
   "targetStartMs": 44489,
   "measuredDurMs": 5760,
   "measuredEndMs": 50249
  },
  {
   "sentenceId": "N07",
   "phraseId": "P2",
   "layoutTier": "推进",
   "text": "那面旗，就是赤色彗星的威光。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 50573,
   "measuredDurMs": 2800,
   "measuredEndMs": 53373
  },
  {
   "sentenceId": "N08",
   "phraseId": "P3",
   "layoutTier": "常规",
   "text": "这台机的纸面相当张扬：全高 22.6 米，全备重量 56.9 吨，出力 3240 千瓦。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 53801,
   "measuredDurMs": 8720,
   "measuredEndMs": 62521
  },
  {
   "sentenceId": "N09",
   "phraseId": "P3",
   "layoutTier": "常规",
   "text": "有意思的是，它不挂一件浮游武器——它的任务，就是把机体本身推向极限。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 63019,
   "measuredDurMs": 6720,
   "measuredEndMs": 69739
  },
  {
   "sentenceId": "N10",
   "phraseId": "P4",
   "layoutTier": "快切",
   "text": "背部展开一对大型推进翼，全身布满推进器。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 70124,
   "measuredDurMs": 3840,
   "measuredEndMs": 73964
  },
  {
   "sentenceId": "N11",
   "phraseId": "P4",
   "layoutTier": "快切",
   "text": "新安洲的答案很直接：机体本身就是武器。",
   "factRefs": [
    "编辑表达"
   ],
   "targetStartMs": 74234,
   "measuredDurMs": 4240,
   "measuredEndMs": 78474
  },
  {
   "sentenceId": "N12",
   "phraseId": "P4",
   "layoutTier": "快切",
   "text": "说到速度，那个称号要回到 U.C. 0079 的战火星海。",
   "factRefs": [
    "E2"
   ],
   "targetStartMs": 78855,
   "measuredDurMs": 4880,
   "measuredEndMs": 83735
  },
  {
   "sentenceId": "N13",
   "phraseId": "P4",
   "layoutTier": "快切",
   "text": "鲁姆会战中，他以一道红色的残影杀穿舰队——从那天起，有了「红色彗星」。",
   "factRefs": [
    "E2"
   ],
   "targetStartMs": 84033,
   "measuredDurMs": 8560,
   "measuredEndMs": 92593
  },
  {
   "sentenceId": "N14",
   "phraseId": "P5",
   "layoutTier": "常规",
   "text": "红色涂装与无人能及的速度，是一枚硬币的两面，共同铸成了那个称号。",
   "factRefs": [
    "E2",
    "E5"
   ],
   "targetStartMs": 93066,
   "measuredDurMs": 5920,
   "measuredEndMs": 98986
  },
  {
   "sentenceId": "N15",
   "phraseId": "P5",
   "layoutTier": "常规",
   "text": "后来的阿克西斯事件与最终决战，让他从对手变成了传说。",
   "factRefs": [
    "E6"
   ],
   "targetStartMs": 99637,
   "measuredDurMs": 5440,
   "measuredEndMs": 105077
  },
  {
   "sentenceId": "N16",
   "phraseId": "P5",
   "layoutTier": "常规",
   "text": "战争的尘埃落定，红色彗星的传说却没有褪色。",
   "factRefs": [
    "E6"
   ],
   "targetStartMs": 105581,
   "measuredDurMs": 4480,
   "measuredEndMs": 110061
  },
  {
   "sentenceId": "N17",
   "phraseId": "P6",
   "layoutTier": "推进",
   "text": "U.C. 0096，带袖的重整登场星海，冲在最前面的正是那台红色机体。",
   "factRefs": [
    "E1",
    "E3"
   ],
   "targetStartMs": 110481,
   "measuredDurMs": 6400,
   "measuredEndMs": 116881
  },
  {
   "sentenceId": "N18",
   "phraseId": "P6",
   "layoutTier": "推进",
   "text": "驾驶者自称弗尔·弗朗特——红色座机、面具、华丽的作战风格。",
   "factRefs": [
    "E3"
   ],
   "targetStartMs": 117307,
   "measuredDurMs": 6560,
   "measuredEndMs": 123867
  },
  {
   "sentenceId": "N19",
   "phraseId": "P6",
   "layoutTier": "推进",
   "text": "人人都说他是夏亚再世，他自己却说，只是一个「容器」。",
   "factRefs": [
    "E3"
   ],
   "targetStartMs": 124413,
   "measuredDurMs": 5360,
   "measuredEndMs": 129773
  },
  {
   "sentenceId": "N20",
   "phraseId": "P7",
   "layoutTier": "快切",
   "text": "精神感应骨架、红色涂装、彗星之名。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 130125,
   "measuredDurMs": 3440,
   "measuredEndMs": 133565
  },
  {
   "sentenceId": "N21",
   "phraseId": "P7",
   "layoutTier": "快切",
   "text": "对联邦军，它产生了实打实的心理压力。",
   "factRefs": [
    "E1"
   ],
   "targetStartMs": 133933,
   "measuredDurMs": 4240,
   "measuredEndMs": 138173
  },
  {
   "sentenceId": "N22",
   "phraseId": "P7",
   "layoutTier": "快切",
   "text": "最后一战，他搭乘新吉翁号，与独角兽正面对决。",
   "factRefs": [
    "E3"
   ],
   "targetStartMs": 138298,
   "measuredDurMs": 4480,
   "measuredEndMs": 142778
  },
  {
   "sentenceId": "N23",
   "phraseId": "P7",
   "layoutTier": "快切",
   "text": "精神与夏亚融合，把未来托付给少年之后，他离去了。",
   "factRefs": [
    "E3"
   ],
   "targetStartMs": 142942,
   "measuredDurMs": 4960,
   "measuredEndMs": 147902
  },
  {
   "sentenceId": "N24",
   "phraseId": "P7",
   "layoutTier": "快切",
   "text": "是本人，还是继承者？",
   "factRefs": [
    "编辑表达"
   ],
   "targetStartMs": 148120,
   "measuredDurMs": 2240,
   "measuredEndMs": 150360
  },
  {
   "sentenceId": "N25",
   "phraseId": "P7",
   "layoutTier": "快切",
   "text": "新安洲，把「红色彗星」的答案留给了整片星海。",
   "factRefs": [
    "编辑表达"
   ],
   "targetStartMs": 150581,
   "measuredDurMs": 4160,
   "measuredEndMs": 154741
  },
  {
   "sentenceId": "N26",
   "phraseId": "P8",
   "layoutTier": "留白",
   "text": "UC 计划的机体、残党的旗舰、传说的复刻、解不开的谜——叠加在一起，才只是这一抹红。",
   "factRefs": [
    "编辑表达"
   ],
   "targetStartMs": 155202,
   "measuredDurMs": 9280,
   "measuredEndMs": 164482
  },
  {
   "sentenceId": "N27",
   "phraseId": "P8",
   "layoutTier": "留白",
   "text": "如果这抹红还让你心动，点赞关注走一波，下期继续聊星海。",
   "factRefs": [
    "CTA"
   ],
   "targetStartMs": 165047,
   "measuredDurMs": 5120,
   "measuredEndMs": 170167
  }
 ]
