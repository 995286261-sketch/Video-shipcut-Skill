      "devMs": 800
    },
    {
      "sentenceId": "N04",
      "text": "120 毫米机枪、280 毫米火箭筒、热能斧，标准三件套。",
      "startMs": 19840,
      "durationMs": 6400,
      "measuredStartMs": 19840,
      "measuredDurMs": 6400,
      "measuredEndMs": 26240,
      "targetStartMs": 19040,
      "targetDurMs": 6247,
      "devMs": 953
    },
    {
      "sentenceId": "N05",
      "text": "外露的动力管谈不上优雅，却给了它独一无二的士兵感——那是普通人的浪漫，不是测试机的浪漫。",
      "startMs": 26240,
      "durationMs": 8720,
      "measuredStartMs": 26240,
      "measuredDurMs": 8720,
      "measuredEndMs": 34960,
      "targetStartMs": 25287,
      "targetDurMs": 9009,
      "devMs": 664
    },
    {
      "sentenceId": "N06",
      "text": "但量产机照样出王牌。鲁姆会战，夏亚的红色扎古单机击沉五艘联邦战舰——四艘巡洋舰，一艘战列舰。",
      "startMs": 34960,
      "durationMs": 10560,
      "measuredStartMs": 34960,
      "measuredDurMs": 10560,
      "measuredEndMs": 45520,
      "targetStartMs": 34296,
      "targetDurMs": 9497,
      "devMs": 1727
    },
    {
      "sentenceId": "N07",
      "text": "赤色彗星，从此得名。",
      "startMs": 45520,
      "durationMs": 2640,
      "measuredStartMs": 45520,
      "measuredDurMs": 2640,
      "measuredEndMs": 48160,
      "targetStartMs": 43793,
      "targetDurMs": 2066,
      "devMs": 2301
    },
    {
      "sentenceId": "N08",
      "text": "同一个战场，乔尼·莱登驾着量产扎古，用 280 火箭筒击沉三艘麦哲伦级。",
      "startMs": 48160,
      "durationMs": 7840,
      "measuredStartMs": 48160,
      "measuredDurMs": 7840,
      "measuredEndMs": 56000,
      "targetStartMs": 45859,
      "targetDurMs": 7431,
      "devMs": 2710
    },
    {
      "sentenceId": "N09",
      "text": "王牌没有挑机体——是量产机和王牌互相成就。这，就是男人的浪漫。",
      "startMs": 56000,
      "durationMs": 6720,
